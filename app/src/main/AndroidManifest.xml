<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 통화 상태(IDLE 전환) 감지 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 통화녹음 파일 읽기: 33+ 는 READ_MEDIA_AUDIO, 32 이하는 READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- [단계 2] 통화 종료 후 화면 위에 별점 팝업(오버레이) 띄우기 (선택 방식) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 통화 후 별점 알림 (기본 방식) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallStar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CallStar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 팝업 "삭제" 버튼용 투명 액티비티 (시스템 삭제 확인창 실행 대행) -->
        <activity
            android:name=".DeleteRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- 별점 알림의 버튼(중요/정리후보/삭제) 처리 -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- 통화 종료 감지 리시버 (상시 FGS 없음, goAsync 로 짧게 동작) -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
